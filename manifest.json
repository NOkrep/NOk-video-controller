{
  "manifest_version": 3,
  "name": "NOk Video Controller",
  "version": "0.4.1",
  "description": "NOkrep tarafından geliştirilen sıfır depolama izinli, Now TV ErCDN SMIL adaptörü, Kick reklam hızlandırıcı, ses yükseltici, dinamik taşma koruması ve site izinleri rehberi.",
  "author": "NOkrep",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NOk Video Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.nowtv.com.tr/*", "*://*.fox.com.tr/*", "*://*.puhutv.com/*", "*://*.kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "injected.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nok-video-controller@nokrep.local",
      "strict_min_version": "109.0"
    }
  }
}
