{
  "manifest_version": 3,
  "name": "NOk Video Controller",
  "version": "0.3.6",
  "description": "NOkrep tarafından geliştirilen sıfır depolama izinli, PuhuTV Akamai & MNCDN akış adaptif kanca (1080p/576p PAL), Kick.com ve tam ekran uyumlu video denetleyicisi.",
  "author": "NOkrep",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NOk Video Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "injected.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nok-video-controller@nokrep.local",
      "strict_min_version": "109.0"
    }
  }
}
