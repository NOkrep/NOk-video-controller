{
  "manifest_version": 3,
  "name": "NOk Video Controller",
  "version": "0.4.9",
  "description": "NOkrep tarafından geliştirilen sıfır depolama izinli, Kick.com React Fiber sıfır donma ses önbelleklemesi, TRT 1 / TRT İzle CDN-V ağ seviyesinde HLS kalite kilitleri ve tam ses/hız eşitlemesi.",
  "author": "NOkrep",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NOk Video Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.nowtv.com.tr/*",
        "*://*.fox.com.tr/*",
        "*://*.puhutv.com/*",
        "*://*.kick.com/*",
        "*://*.trt1.com.tr/*",
        "*://*.trtizle.com/*",
        "*://*.trt.com.tr/*",
        "*://*.trthaber.com.tr/*",
        "*://*.trtspor.com.tr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "injected.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nok-video-controller@nokrep.local",
      "strict_min_version": "109.0"
    }
  }
}
